{
    "name": "eril/calendary",
    "description": "A lightweight, framework-agnostic PHP library for calendar availability, busy periods and bookable time slots.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "calendar",
        "scheduling",
        "availability",
        "booking",
        "time-slots",
        "appointments"
    ],
    "authors": [
        {
            "name": "Eril TS Carvalho",
            "email": "erilandocarvalho@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Eril\\Calendary\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}